<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsSdkPackageVersion>10.0.19041.29</WindowsSdkPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="diagnostics\**" />
    <None Update="routes\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md;THIRD_PARTY.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
